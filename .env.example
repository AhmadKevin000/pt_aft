# Environment variables required to run the admin seed script.
# Copy this file to .env and fill in real values. Never commit .env.

# Database connection (PostgreSQL via DBngin)
DATABASE_URL="postgresql://user:password@localhost:5432/db_ptaft?schema=public"

# Admin auth session secret (min 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET=""

# Required by prisma/seed.ts
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
